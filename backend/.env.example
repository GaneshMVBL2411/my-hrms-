ENVIRONMENT=development

# Supabase Postgres connection string, e.g.
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/hrms

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=hrms-files

# Zoho Mail API (OAuth) — notification emails for leave decisions, letters
# issued, task assignments, announcements. Leave blank to disable emails.
# Setup: https://api-console.zoho.com -> Add Client -> Server-based Application
#   scope: ZohoMail.messages.CREATE,ZohoMail.accounts.READ
# Then exchange the one-time grant code for a refresh token via
#   POST https://accounts.zoho.com/oauth/v2/token
# ZOHO_ACCOUNT_ID is the numeric Zoho Mail account id (not the email address) —
# find it at https://mail.zoho.com/mail/organization/account under API settings,
# or via GET https://mail.zoho.com/api/accounts (with a valid access token).
# Use the .in/.eu accounts/mail domains instead of .com if your Zoho org is on
# a different data center.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=hr@whhoohhpath.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_MAIL_DOMAIN=https://mail.zoho.com

CORS_ORIGINS=["http://localhost:5173"]
