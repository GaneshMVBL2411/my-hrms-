# Copy to server/.env and fill in. Never commit the filled-in file.

# The Neon connection string for the hrms_app role.
# NOT Neon's default role — that owns the tables, and Postgres exempts owners
# from row level security, which would silently disable tenant isolation.
DATABASE_URL=postgresql://hrms_app:PASSWORD@ep-xxxx.region.aws.neon.tech/hrms?sslmode=require

# Signs session tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_TTL=1h

PORT=3001
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------------------- email
# SMTP lives here and only here. Never in the frontend's environment, never in
# the mobile app, never in the database. A value in Vercel's environment is in
# the browser bundle; these belong on the backend deployment (Render or
# equivalent) alone.

# Leave SMTP_HOST empty to disable sending entirely. The HRMS runs without it;
# mail is the only thing that stops.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Leave blank to derive from the port: 465 is implicit TLS, 587 is STARTTLS.
# Setting it wrong is the most common SMTP misconfiguration and fails with a
# timeout that says nothing about the cause.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=HRMS
SMTP_REPLY_TO=

# "development" logs what would have been sent and sends nothing. Anything
# other than "production" is treated as development, so an unconfigured machine
# cannot email real employees by accident.
EMAIL_MODE=development

# Where links in emails point — password resets, payslips, task links. Without
# it, emails that need a link are not sent at all rather than sent broken.
APP_BASE_URL=http://localhost:5173

# Encrypts tenant SMTP passwords before they are stored. Held here rather than
# in the database it protects, so a database dump contains no usable credential.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=
